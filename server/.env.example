SUPABASE_CONNECTION_STRING=
JWT_SECRET=
ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:5173
PORT=3000
WORKER_INTERVALO_MS=60000
# true = a API também roda o worker (produção/Docker); no dev use false e rode `npm run dev:worker`
WORKER_EMBUTIDO=false
# quantos proxies há na frente da API: false = nenhum (dev); 2 = Docker na VPS (Nginx do host → web → api); ou IPs/CIDRs separados por vírgula
TRUST_PROXY=false
