SUPABASE_CONNECTION_STRING=
JWT_SECRET=
ENCRYPTION_KEY=
CORS_ORIGIN=http://localhost:5173
PORT=3000
WORKER_INTERVALO_MS=60000
# true = a API também roda o worker (produção/Docker); no dev use false e rode `npm run dev:worker`
WORKER_EMBUTIDO=false
# false = API exposta direto; 1 = atrás de um proxy (Render, Railway, Nginx); ou IPs/CIDRs do proxy separados por vírgula
TRUST_PROXY=false
